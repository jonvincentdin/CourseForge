# Postgres connection string.
# Local dev example: postgresql://postgres:postgres@localhost:5432/courseforge
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Base URL of the app (used by Auth.js for redirects in some environments).
NEXTAUTH_URL=http://localhost:3000

# Where uploaded syllabus PDFs are stored on disk. Defaults to ./storage
# if unset. NOT suitable for most deployment targets with ephemeral
# filesystems — see .context/DECISIONS.md.
STORAGE_DIR=./storage

# --- Not yet used (reserved for later milestones) ---
# AI provider keys are stored per-user, encrypted, in the database
# (see Milestone 6 / .context/AI_GENERATION.md and .context/SECURITY.md).
# Nothing below this line is read by the app yet.

# ENCRYPTION_KEY=          # server-side key for encrypting user AI API keys (Milestone 6)
